{{#if this.siteSettings.enhanced_ignore_enabled}}
  <fieldset class="retort">
  <div class="control-group enhanced-ignore">
    <label class="control-label">{{i18n "enhanced_ignore.enhanced_ignore"}}</label>

    <div class="controls">
      <PreferenceCheckbox
        @labelKey="enhanced_ignore.hide_ignored_topics"
        @checked={{this.model.custom_fields.hide_ignored_topics}}
      />
      <PreferenceCheckbox
        @labelKey="enhanced_ignore.ignored_user_cannot_reply_to_me"
        @checked={{this.model.custom_fields.ignored_user_cannot_reply_to_me}}
      />
    </div>
  </div>
  </fieldset>
{{/if}}